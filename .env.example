# ===========================================================================
# Xentra Bot — Environment Variables Reference
# ===========================================================================
# Copy this file to .env and fill in your values:
#   cp bot/.env.example bot/.env
# ===========================================================================


# ═══════════════════════════════════════════════════════════════════════════
# 1. REQUIRED — Discord Bot
# ═══════════════════════════════════════════════════════════════════════════
# Read by bot/config.py at startup.

# Discord bot token (from Discord Developer Portal).
DISCORD_TOKEN=

# Application / Client ID (from Discord Developer Portal).
APPLICATION_ID=

# Bot's own public URL.
# This is REQUIRED — the bot will refuse to start if unset.
# The backend verifies the X-Bot-Origin header against this value.
BOT_ORIGIN=

# Frontend URL — REQUIRED in production.
# The bot will refuse to start if unset.
FRONTEND_URL=http://localhost:3000


# ═══════════════════════════════════════════════════════════════════════════
# 2. REQUIRED — Webhook & Backend Connectivity
# ═══════════════════════════════════════════════════════════════════════════
# Read by bot/config.py — connects the bot to the Django backend.

# Backend API base URL (must end with /api/v1/).
BACKEND_URL=http://127.0.0.1:8000/api/v1/

# Shared webhook secret — must match WEBHOOK_SECRET in backend/.env.
# Used for HMAC verification of bot→backend webhook calls.
WEBHOOK_SECRET=

# HMAC signing key for bot→backend signed requests.
# Must match REQUEST_SIGNING_SECRET in backend/.env exactly.
# If empty, bot requests are sent unsigned (dev default).
REQUEST_SIGNING_SECRET=

# HMAC signing key for cluster coordination endpoints (register, heartbeat,
# claim-shards, webhook poll/claim/complete, etc.).
# Falls back to REQUEST_SIGNING_SECRET if not set, but an independent key
# allows rotation without affecting bot→backend request signing.
# Must match CLUSTER_SIGNING_SECRET in backend/.env exactly.
CLUSTER_SIGNING_SECRET=


# ═══════════════════════════════════════════════════════════════════════════
# 3. WEBHOOK SERVER
# ═══════════════════════════════════════════════════════════════════════════
# Read by bot/config.py — configures the bot's aiohttp webhook server
# that receives callbacks from the Django backend.

# Webhook server host (default: 0.0.0.0).
WEBHOOK_HOST=0.0.0.0

# Webhook server port (default: 5000).
# On Railway, the platform auto-assigns PORT — entrypoint.sh and config.py
# both honour PORT as fallback, so you typically do NOT need to set
# WEBHOOK_PORT explicitly on Railway.
# On HF Spaces, set WEBHOOK_PORT=7860 (the port HF expects).
WEBHOOK_PORT=5000


# ═══════════════════════════════════════════════════════════════════════════
# 4. CLUSTER COORDINATION (High-Availability Deployment)
# ═══════════════════════════════════════════════════════════════════════════
# Read by bot/config.py and bot/cluster_worker.py.
#
# Enables sharded Discord bot operation across multiple nodes, with
# automatic heartbeat reporting, shard claiming, and node registration.

# Enable cluster coordination mode (True/False).
CLUSTER_ENABLED=False

# Unique node ID.  If empty, a random UUID is generated on first start.
CLUSTER_NODE_ID=

# Override cluster API base URL (defaults to BACKEND_URL).
CLUSTER_API_URL=

# Heartbeat interval in seconds (default: 30).
# Bot sends a heartbeat to the backend every N seconds to prove it's alive.
CLUSTER_HEARTBEAT_INTERVAL=30

# System hostname (used for node registration).
# Defaults to the system HOSTNAME env var.
HOSTNAME=

# Shard count hint (used in registration; real count comes from Discord).
SHARD_COUNT=1

# Enable auto-sharding (True/False).
AUTO_SHARD=False


# ═══════════════════════════════════════════════════════════════════════════
# 5. OPTIONAL — PDF Generator Service
# ═══════════════════════════════════════════════════════════════════════════
# Read by bot/utils/pdf_service.py — connects the bot to the separate
# PDF generation microservice (xentra-pdf-service).

# PDF Generator URL — the /generate endpoint of the PDF service.
# Example: https://your-pdf-service.hf.space
PDF_GENERATOR_URL=

# Shared secret for verifying callbacks from PDF Generator → Bot.
# Must match PDF_SERVICE_SECRET in xentra-pdf-service/.env exactly.
PDF_SERVICE_SECRET=


# ═══════════════════════════════════════════════════════════════════════════
# 6. OPTIONAL — Development Only
# ═══════════════════════════════════════════════════════════════════════════
# Guild ID for development — slash commands sync to a single guild instantly
# so you don't have to wait for global command propagation.
GUILD_ID=


# ═══════════════════════════════════════════════════════════════════════════
# 7. RAILWAY-SPECIFIC (Platform Auto-Config)
# ═══════════════════════════════════════════════════════════════════════════
# These are automatically set by the Railway platform — do NOT add them to
# your Railway Variables.  Listed here only for documentation.
#
#   PORT        (set by Railway, used as fallback for WEBHOOK_PORT)
